  <diagram id="infra-aws" name="인프라 뷰 v0.2 · AWS 아이콘">
    <mxGraphModel dx="1607" dy="1205" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="1960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
